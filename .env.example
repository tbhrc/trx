# AI Trading Copilot - Environment Variables Configuration
# DO NOT COMMIT THIS FILE TO GIT - Add .env to .gitignore

# =============================================================================
# DATA SOURCE API KEYS (v1.2.2 - Data Ingestion)
# =============================================================================

# Alpha Vantage API Key
# Get free key at: https://www.alphavantage.co/support/#api-key
# Used by: scripts/fetch_headlines.py
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Finnhub API Key
# Get free key at: https://finnhub.io/register
# Used by: scripts/fetch_headlines.py
FINNHUB_API_KEY=your_finnhub_api_key_here

# =============================================================================
# ALERT SYSTEM CREDENTIALS (v1.2.6 - Future)
# =============================================================================

# Email (SMTP) Configuration
# Used for: Email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=AI Trading Copilot

# Twilio SMS Configuration
# Get credentials at: https://www.twilio.com/console
# Used for: SMS alerts
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_TO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging (Push Notifications)
# Get credentials at: https://console.firebase.google.com/
# Used for: Push notifications
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id_here
FIREBASE_PRIVATE_KEY=your_firebase_private_key_here
FIREBASE_CLIENT_EMAIL=your_firebase_client_email_here
FIREBASE_CLIENT_ID=your_firebase_client_id_here

# =============================================================================
# MT4/MT5 BROKER CONFIGURATION (v1.2.7 - Future)
# =============================================================================

# MT4/MT5 Broker Credentials
# Note: These may not be needed if using ZMQ bridge
MT4_SERVER=broker_server_name_here
MT4_LOGIN=12345678
MT4_PASSWORD=your_mt4_password_here

# ZMQ Configuration (for MT4/MT5 bridge)
ZMQ_HOST=localhost
ZMQ_PORT=5555

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=development

# Server Configuration
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Database Configuration (for signal history - v1.2.5)
DATABASE_URL=sqlite:///./data/signals.db

# Logging Level
LOG_LEVEL=INFO

# =============================================================================
# SECURITY & AUTHENTICATION (Future)
# =============================================================================

# Secret key for JWT tokens (if implementing auth)
SECRET_KEY=your_secret_key_here_min_32_characters_random

# Dashboard password (basic auth)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_this_password

# =============================================================================
# OPTIONAL SERVICES
# =============================================================================

# Telegram Bot (for alerts)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Slack Webhook (for alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Discord Webhook (for alerts)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR/WEBHOOK/URL

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Test mode (skip real API calls)
TEST_MODE=false

# Mock data (use sample data instead of live)
USE_MOCK_DATA=false

# Debug mode (verbose logging)
DEBUG=false
