class NewsConfig:
    enabled: bool = True
    calendar_path: str = "data/economic_calendar.csv"
    headlines_path: str = "data/news_headlines.csv"
    block_before_minutes: int = 45
    block_after_minutes: int = 30
    high_impact_only: bool = True
    sentiment_threshold: float = -0.5
